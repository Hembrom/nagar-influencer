# Supabase — paste values from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# App URL for OAuth redirects
# Set this to match your deployment domain (required for Google OAuth to work)
# Examples:
#   Local: http://localhost:3000
#   Vercel staging: https://nagar-influencer.vercel.app
#   Production: https://www.growmyinfluence.in
NEXT_PUBLIC_APP_URL=https://www.growmyinfluence.in

# Server-only (optional, for admin / webhooks later)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
